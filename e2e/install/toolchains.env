# The install gate's toolchain pins (#1546): the one place they are set. toolchains.sh sources this for
# the Linux images, and .github/workflows/install-gate.yml reads it into the environment of the macOS
# and Windows runners, so every machine the gate runs on has the same versions. A toolchain release
# cannot break the gate silently: a version moves only when this file changes.
#
# Plain KEY=VALUE lines, no quotes and no expansion, so both a shell and $GITHUB_ENV read them as-is.
# Node is not here: it comes from the repository's .nvmrc everywhere.
DOTNET_SDK_VERSION=10.0.404
GO_VERSION=1.27.4
GO_SHA256=7226736c2339719cda28fbf3a54d71aa63bcefe376e98cef00034268dab24840
RUST_VERSION=1.100.0
JAVA_VERSION=25.0.5
TEMURIN_RELEASE=jdk-25.0.5.1+2
TEMURIN_ASSET=OpenJDK25U-jdk_x64_linux_hotspot_25.0.5.1_2.tar.gz
TEMURIN_SHA256=760f91b22c3efc9bd1b64ff950598231be82928cc807e30691a0e7a2995a62c0
MAVEN_VERSION=3.9.16
GRADLE_VERSION=9.9.2
CMAKE_VERSION=4.5.1
PYTHON_VERSION=3.13
