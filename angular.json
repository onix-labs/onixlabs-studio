{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "onixlabs-studio": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/shared/app/main.ts",
            "index": "src/shared/app/index.html",
            "baseHref": "./",
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "define": {
              "__VUE_OPTIONS_API__": "false",
              "__VUE_PROD_DEVTOOLS__": "false",
              "__VUE_PROD_HYDRATION_MISMATCH_DETAILS__": "false"
            },
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              },
              {
                "glob": "**/*",
                "input": "node_modules/monaco-editor/min/vs",
                "output": "vs"
              }
            ],
            "styles": [
              "node_modules/@xterm/xterm/css/xterm.css",
              "node_modules/@milkdown/crepe/lib/theme/common/style.css",
              "node_modules/@milkdown/crepe/lib/theme/frame/style.css",
              "node_modules/@phosphor-icons/web/src/thin/style.css",
              "node_modules/@phosphor-icons/web/src/regular/style.css",
              "node_modules/@phosphor-icons/web/src/light/style.css",
              "node_modules/@phosphor-icons/web/src/bold/style.css",
              "node_modules/@phosphor-icons/web/src/fill/style.css",
              "node_modules/@phosphor-icons/web/src/duotone/style.css",
              "src/shared/angular/styles/styles.scss"
            ],
            "allowedCommonJsDependencies": [
              "@xterm/xterm",
              "@xterm/addon-fit",
              "dayjs",
              "dayjs/plugin/advancedFormat.js",
              "dayjs/plugin/duration.js",
              "cytoscape-fcose",
              "cytoscape-cose-bilkent",
              "extend",
              "@braintree/sanitize-url"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "4.5MB",
                  "maximumError": "6MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "8kB",
                  "maximumError": "16kB"
                }
              ],
              "outputHashing": "all",
              "optimization": {
                "scripts": true,
                "fonts": true,
                "styles": {
                  "minify": true,
                  "inlineCritical": false
                }
              }
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "onixlabs-studio:build:production"
            },
            "development": {
              "buildTarget": "onixlabs-studio:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "coverageReporters": ["text-summary", "html", "lcovonly"],
            "coverageThresholds": {
              "statements": 68,
              "branches": 62,
              "functions": 57,
              "lines": 68
            }
          }
        }
      }
    }
  }
}
