{
  "version": 1,
  "runConfigurations": [
    {
      "id": "studio-dev",
      "name": "Studio (Electron, dev)",
      "providerKind": "node",
      "program": "npm",
      "args": [
        "run",
        "electron:serve"
      ],
      "mode": "run",
      "default": true
    },
    {
      "id": "web-serve",
      "name": "Web (ng serve)",
      "providerKind": "node",
      "program": "npm",
      "args": [
        "run",
        "start"
      ],
      "mode": "run"
    },
    {
      "id": "unit-tests",
      "name": "Unit Tests (watch)",
      "providerKind": "node",
      "program": "npm",
      "args": [
        "run",
        "test"
      ],
      "mode": "run"
    },
    {
      "id": "e2e-tests",
      "name": "E2E (Playwright)",
      "providerKind": "node",
      "program": "npm",
      "args": [
        "run",
        "e2e"
      ],
      "mode": "run"
    }
  ]
}
