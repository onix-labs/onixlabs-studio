{
  "id": "onixlabs.rust-tests",
  "name": "Rust Tests",
  "description": "Rust tests in the Tests panel: finds #[test] functions in each crate and runs them with cargo test.",
  "version": "0.1.0",
  "apiVersion": "1.28.0",
  "detail": "Reads your crates' sources to list their tests; running them uses the cargo on your machine, in a terminal you can see.",
  "provision": {
    "kind": "npm",
    "lockfileUrl": "https://raw.githubusercontent.com/onix-labs/onixlabs-studio/main/src/shared/electron/contributions/plugins/lockfiles/onixlabs.rust-tests.lock.json",
    "sha256": "100ebc43686007a81aafc04c4fcd096965144a0df4637eed5be726b9178ace51",
    "executablePath": "node_modules/@onixlabs/rust-tests/main.js"
  },
  "contributes": {
    "testAdapters": [
      {
        "id": "onixlabs.rust-tests",
        "displayName": "Rust Tests",
        "frameworks": ["cargo test"],
        "priority": 100,
        "markers": ["Cargo.toml"],
        "capabilities": ["run", "runSelected"],
        "command": {
          "kind": "node"
        },
        "entryPoint": "node_modules/@onixlabs/rust-tests/main.js"
      }
    ]
  }
}
