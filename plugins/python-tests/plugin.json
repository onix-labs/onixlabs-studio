{
  "id": "onixlabs.python-tests",
  "name": "Python Tests",
  "description": "Python tests: finds what pytest would collect, unittest suites included, runs them, and reads their results back.",
  "version": "0.1.0",
  "apiVersion": "1.28.0",
  "detail": "Reads your test files to find tests, without starting Python. Running them uses the project's own virtual environment (.venv or venv) when it has one, else python3, with pytest installed there, in a terminal you can see.",
  "provision": {
    "kind": "npm",
    "lockfileUrl": "https://raw.githubusercontent.com/onix-labs/onixlabs-studio/plugin-python-tests-v0.1.0/src/shared/electron/contributions/plugins/lockfiles/onixlabs.python-tests.lock.json",
    "sha256": "51ddd6f12c230e90d0dacb54311a55976b175ddbe606544c15e166d9228825d9",
    "executablePath": "node_modules/@onixlabs/python-tests/main.js"
  },
  "contributes": {
    "testAdapters": [
      {
        "id": "onixlabs.python-tests",
        "displayName": "Python Tests",
        "frameworks": ["pytest", "unittest"],
        "priority": 100,
        "markers": [
          "pyproject.toml",
          "pytest.ini",
          "setup.cfg",
          "setup.py",
          "tox.ini",
          "conftest.py",
          "requirements*.txt"
        ],
        "capabilities": ["run", "runSelected", "debug"],
        "command": {
          "kind": "node"
        },
        "entryPoint": "node_modules/@onixlabs/python-tests/main.js"
      }
    ]
  }
}
