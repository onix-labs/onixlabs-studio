{
  "id": "onixlabs.git",
  "name": "Git",
  "description": "Git version control: status, history, diffs, commits, branches, remotes, tags, stashes, merges, rebases, worktree checkouts, ignore rules and per-file history.",
  "version": "0.7.0",
  "apiVersion": "1.14.0",
  "detail": "Drives the git installed on your machine, or one you point it at in Settings. Needs git 2.23 or later.",
  "provision": {
    "kind": "npm",
    "lockfileUrl": "https://raw.githubusercontent.com/onix-labs/onixlabs-studio/main/src/shared/electron/contributions/plugins/lockfiles/onixlabs.git.lock.json",
    "sha256": "32c7e86dc7a8840f041d468176b2ec881bc5f0e5d5bca0113f3b1303986d37c3",
    "executablePath": "node_modules/@onixlabs/git/main.js"
  },
  "contributes": {
    "versionControl": [
      {
        "id": "onixlabs.git",
        "displayName": "Git",
        "priority": 100,
        "markers": [".git"],
        "metadataDirectories": [".git"],
        "metadataSignals": ["HEAD", "*_HEAD", "index", "packed-refs", "refs/**"],
        "capabilities": [
          "stagingArea",
          "stash",
          "tags",
          "remotes",
          "merge",
          "rebase",
          "clone",
          "init",
          "parallelCheckouts",
          "identity",
          "allBranchHistory"
        ],
        "executableModes": ["installed", "custom"],
        "command": {
          "kind": "node"
        },
        "entryPoint": "node_modules/@onixlabs/git/main.js"
      }
    ]
  }
}
