/* TypeScript configuration for the GitHub hosting plugin.
   The plugin is a separate program from Studio: it runs as its own process and talks to it only over
   the hosting protocol. It shares no code with the app — the protocol types are declared locally in
   `src/protocol.ts` — which is the point, and this config is what keeps that true rather than letting
   it reach back into `src/`.
   The build is done by esbuild (see build.mjs); this config is `tsc --noEmit` only. */
{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "ES2022",
    "lib": ["ES2022"],
    "types": ["node"],
    "rootDir": ".",
    "outDir": "dist",
    "esModuleInterop": true,
    "importHelpers": false,
    "noEmit": true,
    "declaration": false
  },
  "include": ["src/**/*.ts"],
  /* The specs run in Studio's unit suite, which supplies their test runner's types. */
  "exclude": ["src/**/*.spec.ts"]
}
