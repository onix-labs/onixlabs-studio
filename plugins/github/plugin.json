{
  "id": "onixlabs.github",
  "name": "GitHub",
  "description": "GitHub hosting: pull requests with their checks, issues and comments, Actions runs (re-run and cancel), and your accounts and repositories — and, for you and your agents, opening issues and pull requests, commenting, and closing or reopening issues.",
  "version": "0.3.0",
  "apiVersion": "1.17.0",
  "detail": "Signs in with the GitHub CLI's login (gh auth login), or a token you add in Settings. Serves github.com.",
  "provision": {
    "kind": "npm",
    "lockfileUrl": "https://raw.githubusercontent.com/onix-labs/onixlabs-studio/main/src/shared/electron/contributions/plugins/lockfiles/onixlabs.github.lock.json",
    "sha256": "cf0c6c4f8dc7557c0ff4af0333c074f75b96a9dcc050efdcdcd46cb288d15aa0",
    "executablePath": "node_modules/@onixlabs/github/main.js"
  },
  "contributes": {
    "hosting": [
      {
        "id": "onixlabs.github",
        "displayName": "GitHub",
        "priority": 100,
        "hosts": ["github.com", "www.github.com"],
        "capabilities": [
          "accounts",
          "listRepositories",
          "createRepository",
          "pullRequests",
          "createPullRequest",
          "issues",
          "createIssue",
          "commentOnIssue",
          "setIssueState",
          "subIssues",
          "ciRuns",
          "ciRerun",
          "ciCancel"
        ],
        "authModes": ["cli", "studio"],
        "commandLineTools": ["gh"],
        "command": {
          "kind": "node"
        },
        "entryPoint": "node_modules/@onixlabs/github/main.js"
      }
    ]
  }
}
