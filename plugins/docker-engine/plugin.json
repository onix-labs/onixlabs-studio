{
  "id": "docker-engine",
  "name": "Docker",
  "description": "Talk to a Docker-compatible container engine over its local socket.",
  "detail": "Speaks to the engine over its local socket; it does not install or run a container engine itself. Open Shell uses the docker command-line tool when one is installed.",
  "version": "30.2.0",
  "apiVersion": "1.19.0",
  "provision": {
    "kind": "npm",
    "lockfileUrl": "https://raw.githubusercontent.com/onix-labs/onixlabs-studio/main/src/shared/electron/contributions/plugins/lockfiles/docker-engine.lock.json",
    "sha256": "cbf1ee60b3a251d376f0fa62a90763d224dc503b9eeafed49bd9917442b372d7",
    "executablePath": "node_modules/@onixlabs/docker-engine/main.js"
  },
  "contributes": {
    "containerEngines": [
      {
        "id": "docker",
        "displayName": "Docker",
        "priority": 100,
        "discovery": {
          "hostVariable": "DOCKER_HOST",
          "dockerContext": true,
          "sockets": {
            "darwin": ["/var/run/docker.sock"],
            "linux": ["/var/run/docker.sock"],
            "win32": ["\\\\.\\pipe\\docker_engine"]
          }
        },
        "startCommands": {
          "darwin": "open -a Docker",
          "linux": "sudo systemctl start docker"
        },
        "command": {
          "kind": "node"
        },
        "cli": "docker",
        "entryPoint": "node_modules/@onixlabs/docker-engine/main.js"
      }
    ]
  },
  "requires": []
}
