{
  "id": "onixlabs.conan",
  "name": "Conan",
  "description": "Conan packages: the C and C++ conanfiles in a folder, what each requires, what its lockfile resolved, what is newer, and search across its remotes.",
  "version": "0.1.0",
  "apiVersion": "1.25.0",
  "detail": "Reads conanfile.txt, conanfile.py (as text, never run), conan.lock and your Conan remotes. Installing runs through the conan on your machine, in a terminal you can see.",
  "provision": {
    "kind": "npm",
    "lockfileUrl": "https://raw.githubusercontent.com/onix-labs/onixlabs-studio/plugin-conan-v0.1.0/src/shared/electron/contributions/plugins/lockfiles/onixlabs.conan.lock.json",
    "sha256": "04176d9bbc35776d13f664283bd462c23074322dffc279797ecc28264b35d032",
    "executablePath": "node_modules/@onixlabs/conan/main.js"
  },
  "contributes": {
    "packageManagers": [
      {
        "id": "onixlabs.conan",
        "displayName": "Conan",
        "ecosystem": "conan",
        "priority": 100,
        "markers": ["conanfile.txt", "conanfile.py"],
        "capabilities": ["sources", "search", "searchRequiresQuery", "restore"],
        "command": {
          "kind": "node"
        },
        "entryPoint": "node_modules/@onixlabs/conan/main.js"
      }
    ]
  }
}
