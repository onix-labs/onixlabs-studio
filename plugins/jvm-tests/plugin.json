{
  "id": "onixlabs.jvm-tests",
  "name": "JVM Tests",
  "description": "JUnit tests in the Tests panel: finds test classes and methods under src/test and runs them with Gradle or Maven.",
  "version": "0.1.0",
  "apiVersion": "1.28.0",
  "detail": "Reads your test sources to list their tests; running them uses your Gradle or Maven wrapper, or the one on your machine, in a terminal you can see.",
  "provision": {
    "kind": "npm",
    "lockfileUrl": "https://raw.githubusercontent.com/onix-labs/onixlabs-studio/main/src/shared/electron/contributions/plugins/lockfiles/onixlabs.jvm-tests.lock.json",
    "sha256": "e9aaf8744c0e1182a6c2d229e831baf5bb5b456e9019b6f66a1d3c8f2574d95d",
    "executablePath": "node_modules/@onixlabs/jvm-tests/main.js"
  },
  "contributes": {
    "testAdapters": [
      {
        "id": "onixlabs.jvm-tests",
        "displayName": "JVM Tests",
        "frameworks": ["JUnit 5"],
        "priority": 100,
        "markers": ["pom.xml", "build.gradle", "build.gradle.kts"],
        "capabilities": ["run", "runSelected"],
        "command": {
          "kind": "node"
        },
        "entryPoint": "node_modules/@onixlabs/jvm-tests/main.js"
      }
    ]
  }
}
