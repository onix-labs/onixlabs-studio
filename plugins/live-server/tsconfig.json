/* TypeScript configuration for the Live Server plugin.
   The plugin is a separate program from Studio: it runs as its own process and talks to it only over
   the live-server protocol. It shares no code with the app.
   The build is done by esbuild (see build.mjs); this config is `tsc --noEmit` only. */
{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "ES2022",
    "lib": ["ES2022"],
    "types": ["node"],
    "esModuleInterop": true,
    "importHelpers": false,
    "noEmit": true,
    "declaration": false
  },
  "include": ["src/**/*.ts"],
  /* The specs run in Studio's unit suite, which supplies their test runner's types. */
  "exclude": ["src/**/*.spec.ts"]
}
