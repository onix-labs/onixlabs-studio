{
  "id": "onixlabs.cargo",
  "name": "Cargo",
  "description": "Cargo crates: the Rust crates and workspaces in a folder, what each depends on, what Cargo.lock resolved, what is newer, and search across crates.io and your registries.",
  "version": "0.1.0",
  "apiVersion": "1.25.0",
  "detail": "Reads your Cargo.toml files, Cargo.lock and Cargo's own config and credentials. Adding, updating and removing run through the cargo on your machine, in a terminal you can see.",
  "provision": {
    "kind": "npm",
    "lockfileUrl": "https://raw.githubusercontent.com/onix-labs/onixlabs-studio/plugin-cargo-v0.1.0/src/shared/electron/contributions/plugins/lockfiles/onixlabs.cargo.lock.json",
    "sha256": "6a36ac9c68fc42baf3d4229d76889bf32dd90b0cae4f085435944a8ad81069e7",
    "executablePath": "node_modules/@onixlabs/cargo/main.js"
  },
  "contributes": {
    "packageManagers": [
      {
        "id": "onixlabs.cargo",
        "displayName": "Cargo",
        "ecosystem": "cargo",
        "priority": 100,
        "markers": ["Cargo.toml"],
        "capabilities": [
          "sources",
          "search",
          "prerelease",
          "install",
          "update",
          "remove",
          "restore"
        ],
        "command": {
          "kind": "node"
        },
        "entryPoint": "node_modules/@onixlabs/cargo/main.js"
      }
    ]
  }
}
