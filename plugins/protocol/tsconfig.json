/* TypeScript configuration for the plugin protocol modules: the decoders' `listing.ts`, and the
   database engines' `database/`. Shared between the plugins of each kind and bundled into each of them, so every plugin artefact stays
   self-contained. Deliberately separate from the application's `src/`: a decoder's contract with
   Studio is the wire protocol, not shared TypeScript. */
{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "ES2022",
    "lib": ["ES2022"],
    "types": ["node"],
    "esModuleInterop": true,
    "importHelpers": false,
    "noEmit": true,
    "declaration": false
  },
  "include": ["*.ts", "database/*.ts"],
  /* The specs run in Studio's unit suite, which supplies their test runner's types. */
  "exclude": ["**/*.spec.ts"]
}
