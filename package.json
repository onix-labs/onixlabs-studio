{
  "name": "onixlabs-studio",
  "version": "0.0.1",
  "description": "A modern cross-platform integrated development environment",
  "keywords": [
    "ONIXLabs",
    "Studio",
    "IDE"
  ],
  "homepage": "https://github.com/onix-labs/onixlabs-studio#readme",
  "bugs": {
    "url": "https://github.com/onix-labs/onixlabs-studio/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onix-labs/onixlabs-studio.git"
  },
  "license": "MIT",
  "author": "ONIXlabs",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:electron": "tsc --noEmit -p src/shared/electron/tsconfig.json && npm run build:main && npm run build:preload",
    "build:main": "esbuild src/shared/electron/main.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist-electron/electron/main.js --packages=external --tsconfig=tsconfig.json --sourcemap",
    "build:preload": "esbuild src/shared/electron/preload.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist-electron/electron/preload.js --packages=external --tsconfig=tsconfig.json --sourcemap",
    "rebuild": "electron-rebuild --only node-pty",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:coverage": "ng test --watch=false --coverage",
    "e2e": "playwright test --config e2e/playwright.config.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,html,scss,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,html,scss,json,md}\"",
    "electron": "electron .",
    "electron:serve": "concurrently -k -n NG,ELECTRON -c blue,green \"ng serve --host 127.0.0.1\" \"wait-on http://127.0.0.1:4200 && npm run build:electron && cross-env ELECTRON_START_URL=http://127.0.0.1:4200 electron .\"",
    "electron:build": "ng build && npm run build:electron && electron .",
    "pack": "ng build && npm run build:electron && electron-builder --dir",
    "dist": "ng build && npm run build:electron && electron-builder",
    "dist:mac": "ng build && npm run build:electron && electron-builder --mac",
    "dist:win": "ng build && npm run build:electron && electron-builder --win",
    "dist:linux": "ng build && npm run build:electron && electron-builder --linux"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.84",
    "@ai-sdk/openai-compatible": "^2.0.51",
    "@angular/cdk": "^22.0.0",
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/router": "^22.0.0",
    "@anthropic-ai/claude-agent-sdk": "^0.3.177",
    "@milkdown/crepe": "^7.21.2",
    "@phosphor-icons/web": "^2.1.2",
    "@vscode/ripgrep": "^1.18.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-search": "^0.15.0",
    "@xterm/xterm": "^5.5.0",
    "ai": "^6.0.205",
    "an-array-of-english-words": "^2.0.0",
    "diff": "^9.0.0",
    "disassembler": "^0.3.0-beta",
    "marked": "^18.0.5",
    "mermaid": "^11.15.0",
    "monaco-editor": "^0.55.1",
    "node-pty": "^1.1.0",
    "prosemirror-search": "^1.1.1",
    "pyright": "^1.1.410",
    "remark-gemoji": "^8.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "typescript-language-server": "^4.4.1",
    "vscode-jsonrpc": "^8.2.1",
    "vscode-languageserver-protocol": "^3.18.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@angular/build": "^22.0.0",
    "@angular/cli": "^22.0.0",
    "@angular/compiler-cli": "^22.0.0",
    "@electron/rebuild": "^4.0.4",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@types/diff": "^7.0.2",
    "@types/node": "^24.13.1",
    "@vitest/coverage-v8": "^4.1.8",
    "angular-eslint": "^22.0.0",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "electron": "^42.4.0",
    "electron-builder": "^26.15.2",
    "esbuild": "^0.28.1",
    "eslint": "^10.4.1",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.61.0",
    "vitest": "^4.0.8",
    "wait-on": "^9.0.10"
  }
}
