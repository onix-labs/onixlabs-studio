{
  "name": "onixlabs-studio",
  "version": "2026.1.0-beta.4",
  "description": "A modern cross-platform integrated development environment",
  "keywords": [
    "ONIXLabs",
    "Studio",
    "IDE"
  ],
  "homepage": "https://github.com/onix-labs/onixlabs-studio#readme",
  "bugs": {
    "url": "https://github.com/onix-labs/onixlabs-studio/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onix-labs/onixlabs-studio.git"
  },
  "license": "MIT",
  "author": "ONIXlabs",
  "main": "dist-electron/electron/main.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:electron": "tsc --noEmit -p src/shared/electron/tsconfig.json && npm run build:main && npm run build:preload",
    "typecheck:plugins": "node scripts/typecheck-plugins.mjs",
    "build:main": "esbuild src/shared/electron/main.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist-electron/electron/main.js --packages=external --tsconfig=tsconfig.json --sourcemap",
    "build:preload": "esbuild src/shared/electron/preload.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist-electron/electron/preload.js --packages=external --tsconfig=tsconfig.json --sourcemap",
    "rebuild": "electron-rebuild --only node-pty",
    "postinstall": "npm run rebuild",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:coverage": "ng test --watch=false --coverage",
    "verify:plugin-index": "node scripts/verify-plugin-index.mjs",
    "pack:plugin": "node scripts/pack-plugin-tarball.mjs",
    "e2e": "node plugins/native-decoder/build.mjs && node plugins/jvm-decoder/build.mjs && playwright test --config e2e/playwright.config.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,html,scss,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,html,scss,json,md}\"",
    "electron": "electron .",
    "electron:serve": "concurrently -k -s command-ELECTRON -n NG,ELECTRON -c blue,green \"ng serve --host 127.0.0.1\" \"wait-on http://127.0.0.1:4200 && npm run build:electron && cross-env ELECTRON_START_URL=http://127.0.0.1:4200 electron .\"",
    "electron:build": "ng build && npm run build:electron && electron .",
    "pack": "ng build && npm run build:electron && electron-builder --dir",
    "dist": "ng build && npm run build:electron && electron-builder",
    "dist:mac": "ng build && npm run build:electron && electron-builder --mac",
    "dist:win": "ng build && npm run build:electron && electron-builder --win",
    "dist:linux": "ng build && npm run build:electron && electron-builder --linux"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.53",
    "@ai-sdk/google": "^4.0.68",
    "@ai-sdk/openai": "^4.0.66",
    "@ai-sdk/openai-compatible": "^3.0.48",
    "@angular/cdk": "^22.1.6",
    "@angular/common": "^22.1.6",
    "@angular/compiler": "^22.1.6",
    "@angular/core": "^22.1.6",
    "@angular/forms": "^22.1.6",
    "@angular/platform-browser": "^22.1.6",
    "@angular/router": "^22.1.6",
    "@anthropic-ai/claude-agent-sdk": "^0.3.269",
    "@defasm/core": "^2.4.5",
    "@milkdown/crepe": "^7.22.1",
    "@openai/codex-sdk": "^0.154.0",
    "@phosphor-icons/web": "^2.1.2",
    "@vscode/ripgrep": "^1.18.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/xterm": "^6.0.0",
    "ai": "^7.0.98",
    "an-array-of-english-words": "^2.0.0",
    "diff": "^9.0.0",
    "dompurify": "^3.4.15",
    "katex": "^0.18.7",
    "marked": "^18.0.12",
    "mermaid": "^11.16.1",
    "monaco-editor": "^0.56.0",
    "node-pty": "^1.1.0",
    "prosemirror-search": "^1.1.1",
    "remark-gemoji": "^8.0.0",
    "rxjs": "~7.8.0",
    "systeminformation": "^5.33.10",
    "tslib": "^2.3.0",
    "vscode-jsonrpc": "^9.0.2",
    "vscode-languageserver-protocol": "^3.18.3",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@angular/build": "^22.1.8",
    "@angular/cli": "^22.1.8",
    "@angular/compiler-cli": "^22.1.6",
    "@electron/rebuild": "^4.2.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/diff": "^8.0.0",
    "@types/dompurify": "^3.2.0",
    "@types/katex": "^0.16.8",
    "@types/node": "^26.5.1",
    "@vitest/coverage-v8": "^4.1.11",
    "@vscode/debugprotocol": "^1.68.0",
    "angular-eslint": "^22.5.0",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "disassembler": "^0.3.0-beta",
    "electron": "^42.11.3",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.0.8",
    "wait-on": "^9.1.0"
  }
}
